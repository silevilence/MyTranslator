@inherits LayoutComponentBase
@using MyTranslator.Shared.Services
@inject IStringLocalizer<Navigation> Localizer
@inject ThemeService Theme
@inject AuthStateProvider Auth
@inject NavigationManager Nav

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="ToggleDrawer" aria-label="@Localizer["Menu"]" />
        <MudText Typo="Typo.h6" Class="ms-2">@Localizer["AppTitle"]</MudText>
        <MudSpacer />
        <MudIconButton Icon="@(Theme.IsDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                       Color="Color.Inherit" OnClick="ToggleThemeAsync"
                       aria-label="@Localizer[Theme.IsDark ? "LightMode" : "DarkMode"]" />
        <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" OnClick="LogoutAsync"
                       aria-label="@Localizer["Logout"]" />
    </MudAppBar>

    <MudDrawer Open="_drawerOpen" Variant="DrawerVariant.Responsive" Breakpoint="Breakpoint.Md" Elevation="2">
        <MudNavMenu>
            <MudNavLink Href="/" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
                @Localizer["NavHome"]
            </MudNavLink>
            <MudNavLink Href="/tasks/import" Icon="@Icons.Material.Filled.Add">
                @Localizer["NavTasks"]
            </MudNavLink>
            <MudNavLink Href="/terms" Icon="@Icons.Material.Filled.MenuBook">
                @Localizer["NavTerms"]
            </MudNavLink>
            <MudNavLink Icon="@Icons.Material.Filled.Key" Disabled="true">
                @Localizer["NavTokens"]
            </MudNavLink>
            <MudNavLink Href="/settings" Icon="@Icons.Material.Filled.Settings">
                @Localizer["NavSettings"]
            </MudNavLink>
        </MudNavMenu>
    </MudDrawer>

    <MudMainContent>
        <main class="mt-page">
            @Body
        </main>
    </MudMainContent>
</MudLayout>

@code {
    private bool _drawerOpen = true;

    private void ToggleDrawer() => _drawerOpen = !_drawerOpen;

    private async Task ToggleThemeAsync() => await Theme.ToggleAsync();

    private async Task LogoutAsync()
    {
        await Auth.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
