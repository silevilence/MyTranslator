<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- 发布产物裁剪（仅 publish 生效，dotnet run 不受影响）：
         开发态启动 219 文件/37MB/约 6s，裁剪+预压缩后实测启动 <1.1s。发布流程由容器化任务正式托管。 -->
    <PublishTrimmed Condition=" '$(Configuration)' == 'Release' ">true</PublishTrimmed>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.9" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Extensions.Localization" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyTranslator.Shared\MyTranslator.Shared.csproj" />
  </ItemGroup>

  <!-- resx 统一放 Resources/（组件规范 §5），LogicalName 保持与 IStringLocalizer<T> 类型全名一致 -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\App.resx">
      <LogicalName>MyTranslator.Web.App.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Login.resx">
      <LogicalName>MyTranslator.Web.Pages.Login.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Navigation.resx">
      <LogicalName>MyTranslator.Web.Layout.Navigation.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TaskImport.resx">
      <LogicalName>MyTranslator.Web.Pages.TaskImport.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TaskDetail.resx">
      <LogicalName>MyTranslator.Web.Pages.TaskDetail.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\Settings.resx">
      <LogicalName>MyTranslator.Web.Pages.Settings.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>


</Project>
