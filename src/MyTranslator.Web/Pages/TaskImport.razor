@page "/tasks/import"
@attribute [Authorize]
@using MyTranslator.Shared.Models
@using MyTranslator.Shared.Services
@inject ImportExportService Import
@inject ApiErrorMessageProvider ErrorProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IStringLocalizer<TaskImport> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

<MudText Typo="Typo.h1">@Localizer["Title"]</MudText>
<MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Localizer["Subtitle"]</MudText>

<MudTabs Class="mt-4" Rounded="true" Outlined="true">
    <MudTabPanel Text="@Localizer["TabFile"]" Icon="@Icons.Material.Filled.UploadFile">
        <div class="pa-6">
            <FileImportPanel OnCreated="OnFileCreated" />
        </div>
    </MudTabPanel>

    <MudTabPanel Text="@Localizer["TabUrl"]" Icon="@Icons.Material.Filled.Link">
        <div class="pa-6">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["UrlSectionDescription"]</MudText>

            <MudTextField T="string"
                          Label="@Localizer["UrlLabel"]"
                          HelperText="@Localizer["UrlHelper"]"
                          Variant="Variant.Outlined"
                          InputType="InputType.Url"
                          @bind-Value="_url"
                          Error="_urlError is not null"
                          ErrorText="_urlError"
                          Class="mt-4" />

            <div class="mt-6">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Link"
                           Disabled="_busy || string.IsNullOrWhiteSpace(_url)"
                           OnClick="SubmitUrlAsync">
                    @if (_busy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    }
                    @(_busy ? Localizer["ImportingUrl"] : Localizer["ImportUrl"])
                </MudButton>
            </div>
        </div>
    </MudTabPanel>
</MudTabs>

@code {
    private string _url = string.Empty;
    private string? _urlError;
    private bool _busy;

    private void OnFileCreated(TaskSummary summary)
    {
        Snackbar.Add(Localizer["ImportCreated"], Severity.Success);
        Nav.NavigateTo($"/tasks/{summary.TaskId}");
    }

    private async Task SubmitUrlAsync()
    {
        var url = _url.Trim();
        _urlError = null;
        if (string.IsNullOrEmpty(url))
        {
            _urlError = Localizer["UrlRequired"];
            return;
        }

        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri)
            || (uri.Scheme != Uri.UriSchemeHttp && uri.Scheme != Uri.UriSchemeHttps))
        {
            _urlError = Localizer["UrlInvalid"];
            return;
        }

        _busy = true;
        try
        {
            var summary = await Import.CreateFromUrlAsync(url);
            Snackbar.Add(Localizer["ImportCreated"], Severity.Success);
            Nav.NavigateTo($"/tasks/{summary.TaskId}");
        }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            Snackbar.Add(ErrorProvider.ForException(ex), Severity.Error);
        }
        finally
        {
            _busy = false;
        }
    }
}
