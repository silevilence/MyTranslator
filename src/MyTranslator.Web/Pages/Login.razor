@page "/login"
@layout LoginLayout
@attribute [AllowAnonymous]
@using MyTranslator.Shared.Services
@inject AuthStateProvider Auth
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject IConfiguration Config
@inject ISnackbar Snackbar
@inject IStringLocalizer<Login> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Small" Class="mt-16">
    <MudPaper Elevation="4" Class="pa-8">
        <MudText Typo="Typo.h5" Align="Align.Center">@Localizer["AppTitle"]</MudText>
        <MudText Typo="Typo.body2" Align="Align.Center" Color="Color.Secondary" Class="mt-2">
            @Localizer["Subtitle"]
        </MudText>

        <MudTextField T="string"
                      Label="@Localizer["TokenLabel"]"
                      HelperText="@Localizer["TokenHint"]"
                      Variant="Variant.Outlined"
                      InputType="InputType.Password"
                      Adornment="Adornment.End"
                      AdornmentIcon="@(_showToken ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                      OnAdornmentClick="ToggleTokenVisibility"
                      @bind-Value="_token"
                      Class="mt-8" />

        <div class="mt-dev-token">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["DevTokenLabel"]</MudText>
            <div class="mt-dev-token-row">
                <code class="mt-mono mt-dev-token-value">@Localizer["DevTokenValue"]</code>
                @if (!string.IsNullOrEmpty(_devToken))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Input"
                               OnClick="FillDevTokenAsync">
                        @Localizer["DevTokenButton"]
                    </MudButton>
                }
                <MudIconButton Size="Size.Small" Color="Color.Default"
                               Icon="@Icons.Material.Filled.ContentCopy"
                               aria-label="@Localizer["CopyToken"]"
                               OnClick="CopyDevTokenAsync" />
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2" role="alert">@_error</MudText>
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true" Class="mt-6"
                   Disabled="_busy" OnClick="OnLoginAsync" StartIcon="@Icons.Material.Filled.Login">
            @(_busy ? Localizer["Saving"] : Localizer["Login"])
        </MudButton>
    </MudPaper>
</MudContainer>

@code {
    private string _token = string.Empty;
    private string? _devToken;
    private bool _showToken;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        // 开发环境一键填入：仅在本地配置 Auth:DevToken 时启用（生产为空则不显示按钮）
        _devToken = Config["Auth:DevToken"];

        // 已保存 Token 视为已登录，直接进入主界面
        if (await Auth.GetTokenAsync() is { Length: > 0 })
        {
            Nav.NavigateTo(GetReturnUrl());
        }
    }

    private async Task OnLoginAsync()
    {
        var token = _token.Trim();
        if (string.IsNullOrEmpty(token))
        {
            _error = Localizer["RequiredError"];
            return;
        }

        _busy = true;
        _error = null;
        try
        {
            await Auth.LoginAsync(token);
            Snackbar.Add(Localizer["Saved"], Severity.Success);
            Nav.NavigateTo(GetReturnUrl());
        }
        finally
        {
            _busy = false;
        }
    }

    private void FillDevTokenAsync()
    {
        if (string.IsNullOrEmpty(_devToken))
        {
            return;
        }

        _token = _devToken;
        Snackbar.Add(Localizer["DevTokenFilled"], Severity.Info);
    }

    private async Task CopyDevTokenAsync()
    {
        var ok = await Js.InvokeAsync<bool>("mtStorage.copyText", Localizer["DevTokenValue"]);
        Snackbar.Add(ok ? Localizer["TokenCopied"] : Localizer["CopyFailed"],
            ok ? Severity.Success : Severity.Error);
    }

    private void ToggleTokenVisibility() => _showToken = !_showToken;

    private string GetReturnUrl()
    {
        var queryStart = Nav.Uri.IndexOf('?');
        if (queryStart < 0)
        {
            return "/";
        }

        var query = Nav.Uri[(queryStart + 1)..];
        foreach (var part in query.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && kv[0] == "returnUrl")
            {
                return Uri.UnescapeDataString(kv[1].Replace('+', ' '));
            }
        }

        return "/";
    }
}
