@page "/tasks/{TaskId:guid}"
@attribute [Authorize]
@using MyTranslator.Shared.Models
@using MyTranslator.Shared.Services
@inject ImportExportService Import
@inject ApiErrorMessageProvider ErrorProvider
@inject IJSRuntime Js
@inject ISnackbar Snackbar
@inject IStringLocalizer<TaskDetail> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

@if (_loadError is not null)
{
    <ErrorBanner Message="@_loadError" OnRetry="LoadAsync" />
}
else if (_summary is null)
{
    <MudSkeleton Width="100%" Height="120px" />
    <MudSkeleton Width="100%" Height="320px" Class="mt-4" />
}
else
{
    <MudText Typo="Typo.h1">@Localizer["Title"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
        <code class="mt-mono">@_summary.TaskId</code>
    </MudText>

    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
        <div class="mt-task-header">
            <div class="mt-task-header-left">
                <TaskStatusBadge Status="@_summary.Status" />
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="ms-2">
                    @Localizer["Revision", _summary.ExtractionRevision]
                </MudText>
            </div>
            <div class="mt-task-export">
                <MudButton Variant="Variant.Filled" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.Download"
                           Disabled="_exporting || !CanExport"
                           OnClick="ExportAsync">
                    @if (_exporting)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
                    }
                    @Localizer["Export"]
                </MudButton>
                @if (!CanExport)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@Localizer["ExportNotReady"]</MudText>
                }
            </div>
        </div>

        <MudDivider Class="my-4" />

        <div class="mt-task-meta">
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["SourceSection"]</MudText>
                <MudText Typo="Typo.body1">@GetSourceDisplay()</MudText>
                @if (_summary.Source?.FinalUrl is not null)
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        @Localizer["FinalUrl"]<span class="ms-1">@_summary.Source.FinalUrl</span>
                    </MudText>
                }
            </div>
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["FileType"]</MudText>
                <MudText Typo="Typo.body1">@_summary.FileType</MudText>
            </div>
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["Encoding"]</MudText>
                <MudText Typo="Typo.body1">@(_summary.OriginalEncoding ?? Localizer["EncodingUnknown"])</MudText>
            </div>
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["ByteLength"]</MudText>
                <MudText Typo="Typo.body1">@FormatBytes(_summary.Source?.ByteLength)</MudText>
            </div>
            <div>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["Counts"]</MudText>
                <MudText Typo="Typo.body1">
                    @Localizer["CountsSegments", _summary.Counts?.Segments ?? 0]、
                    @Localizer["CountsProtected", _summary.Counts?.ProtectedBlocks ?? 0]、
                    @Localizer["CountsChapters", _summary.Counts?.Chapters ?? 0]
                </MudText>
            </div>
            @if (_summary.Segmentation is { } segmentation)
            {
                <div>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["SegmentationSection"]</MudText>
                    <MudText Typo="Typo.body1">@GetSegmentationDisplay(segmentation)</MudText>
                </div>
            }
        </div>
    </MudPaper>

    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
        <TranslationRunPanel @key="(TaskId, _summary.ExtractionRevision)"
                             TaskId="TaskId"
                             ExtractionRevision="_summary.ExtractionRevision"
                             ExternalBusy="_reviewRunActive || _editorDirty"
                             OnActivityChanged="OnTranslationActivityChangedAsync"
                             OnTranslationsCommitted="OnTranslationsCommittedAsync"
                             OnTaskStateChanged="OnRunTaskStateChangedAsync" />
    </MudPaper>

    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
        <ReviewRunPanel @key="(TaskId, _summary.ExtractionRevision)"
                        TaskId="TaskId"
                        ExtractionRevision="_summary.ExtractionRevision"
                        ExternalBusy="_translationRunActive || _editorDirty"
                        OnActivityChanged="OnReviewActivityChangedAsync"
                        OnCommentsCommitted="OnReviewCommentsCommittedAsync"
                        OnRunStateChanged="OnRunReviewStateChangedAsync" />
    </MudPaper>

    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
        <MudText Typo="Typo.h2">@Localizer["SegmentsTitle"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Localizer["SegmentsHint"]</MudText>

        <div class="mt-task-tm-languages">
            <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["TmLanguagePairLabel"]</MudText>
            <MudTextField T="string"
                          Value="@_tmSourceLanguageInput"
                          ValueChanged="OnTmSourceLanguageInputChanged"
                          Label="@Localizer["TmSourceLanguageLabel"]"
                          Variant="Variant.Outlined"
                          Class="mt-task-tm-language-field"
                          Error="_tmLanguageError is not null"
                          ErrorText="@_tmLanguageError"
                          OnBlur="@(() => CommitLanguagesAsync())"
                          OnKeyDown="OnTmLanguageKeyDownAsync" />
            <MudTextField T="string"
                          Value="@_tmTargetLanguageInput"
                          ValueChanged="OnTmTargetLanguageInputChanged"
                          Label="@Localizer["TmTargetLanguageLabel"]"
                          Variant="Variant.Outlined"
                          Class="mt-task-tm-language-field"
                          Error="_tmLanguageError is not null"
                          ErrorText="@_tmLanguageError"
                          OnBlur="@(() => CommitLanguagesAsync())"
                          OnKeyDown="OnTmLanguageKeyDownAsync" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">@Localizer["TmLanguageHint"]</MudText>
        </div>

        <div class="mt-task-segments">
            <TranslationEditor @ref="_segmentList" @key="(TaskId, _segmentsKey, _summary.ExtractionRevision)"
                               TaskId="TaskId" ExtractionRevision="_summary.ExtractionRevision"
                               Language="_tmLanguage" Busy="_translationRunActive || _reviewRunActive"
                               OnSaved="LoadAsync" OnRevisionChanged="OnSegmentsRevisionChanged"
                               OnDirtyChanged="dirty => _editorDirty = dirty" />
        </div>
    </MudPaper>

    @if (_summary.Capabilities?.CanReextract == true && !_editorDirty && !_translationRunActive && !_reviewRunActive)
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
            <ReextractionPanel TaskId="@TaskId" OnApplied="OnReextractionApplied" />
        </MudPaper>
    }
}

@code {
    private TaskSummary? _summary;
    private string? _loadError;
    private bool _exporting;
    private int _segmentsKey;
    private TranslationEditor? _segmentList;
    private bool _translationRunActive;
    private bool _reviewRunActive;
    private bool _editorDirty;
    private Guid? _loadedTaskId;

    /// <summary>历史对比语言对输入框值；失焦提交后才作用于对比请求，避免输入中间态触发请求。</summary>
    private string _tmSourceLanguageInput = string.Empty;

    /// <summary>缺省目标语言与翻译面板一致（zh-CN），可为空由用户输入。</summary>
    private string _tmTargetLanguageInput = "zh-CN";

    /// <summary>已提交的历史对比语言对；未设置时两字段为 null（面板显示提示，不发起请求）。</summary>
    private LanguagePair _tmLanguage = new(null, null);

    /// <summary>语言对行内校验错误（源/目标相同等）；非 null 时两个输入框展示错误。</summary>
    private string? _tmLanguageError;

    /// <summary>任务摘要声明的公开导出条件（§4.3 capabilities.canExport）。</summary>
    private bool CanExport => _summary?.Capabilities?.CanExport == true && !_editorDirty && !_translationRunActive && !_reviewRunActive;

    [Parameter]
    public Guid TaskId { get; set; }

    protected override async Task OnParametersSetAsync()
    {
        if (_loadedTaskId == TaskId) return;
        _loadedTaskId = TaskId;
        _summary = null;
        _editorDirty = false;
        _translationRunActive = false;
        _reviewRunActive = false;
        _tmLanguage = new(null, null);
        _tmSourceLanguageInput = string.Empty;
        _tmTargetLanguageInput = "zh-CN";
        // 历史对比语言对按任务持久化，刷新后恢复上次输入（与 ProviderSelectionStore 同一前端约定）
        var pair = await TaskLanguagePairStore.LoadAsync(Js, TaskId);
        if (pair.SourceLanguage is not null || pair.TargetLanguage is not null)
        {
            _tmLanguage = pair;
            _tmSourceLanguageInput = pair.SourceLanguage ?? string.Empty;
            _tmTargetLanguageInput = pair.TargetLanguage ?? string.Empty;
        }

        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            _summary = await Import.GetTaskAsync(TaskId);
        }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            _loadError = ErrorProvider.ForException(ex);
        }
    }

    private async Task OnReextractionApplied(TaskSummary summary)
    {
        // 重新提取后：分段 ID 全部更换、extractionRevision 递增，旧列表与游标失效，从第一页重新加载
        _summary = summary;

        _segmentsKey++;
    }

    private async Task OnTranslationsCommittedAsync()
    {
        // 翻译运行成功分段数增加：同修订内就地刷新分段，保留滚动位置（AI 翻译约定 §11.1 第 4 步）
        if (_segmentList is not null)
        {
            await _segmentList.RefreshAsync();
        }
    }

    private async Task OnRunTaskStateChangedAsync()
    {
        // 翻译运行进入终态或创建被互斥/配置阻断：刷新任务摘要（状态/canExport）与分段
        await LoadAsync();
        if (_segmentList is not null)
        {
            await _segmentList.RefreshAsync();
        }
    }

    /// <summary>翻译运行活动状态翻转：置位互斥标记，禁用审核面板（同锁互斥，AI 审核约定 §2.4）。</summary>
    private Task OnTranslationActivityChangedAsync(bool active)
    {
        _translationRunActive = active;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>审核运行活动状态翻转：置位互斥标记，禁用翻译面板（同锁互斥，AI 审核约定 §2.4）。</summary>
    private Task OnReviewActivityChangedAsync(bool active)
    {
        _reviewRunActive = active;
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// 审核运行本轮成功提交意见的分段数增加：重新读取已加载分段，
    /// 使逐批提交的意见出现在列表中（AI 审核约定 §12.1 第 4 步）。
    /// </summary>
    private async Task OnReviewCommentsCommittedAsync()
    {
        if (_segmentList is not null)
        {
            await _segmentList.RefreshAsync();
        }
    }

    /// <summary>审核运行进入终态或创建被阻断：任务公共状态不变，仅刷新分段展示本轮意见。</summary>
    private async Task OnRunReviewStateChangedAsync()
    {
        if (_segmentList is not null)
        {
            await _segmentList.RefreshAsync();
        }
    }

    private async Task OnSegmentsRevisionChanged()
    {
        // 分页期间任务被重新提取（409 extraction_revision_changed）：按契约从第一页重新加载

        _segmentsKey++;
        await LoadAsync();
    }

    private async Task ExportAsync()
    {
        if (_summary is null || _exporting || !CanExport)
        {
            return;
        }

        _exporting = true;
        try
        {
            var result = await Import.ExportAsync(TaskId);
            var base64 = Convert.ToBase64String(result.Content);
            var downloaded = await Js.InvokeAsync<bool>(
                "mtDownload.download", result.FileName, result.MediaType, base64);
            Snackbar.Add(
                downloaded ? Localizer["ExportStarted"] : Localizer["ExportFailedBrowser"],
                downloaded ? Severity.Success : Severity.Error);
        }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            Snackbar.Add(ErrorProvider.ForException(ex), Severity.Error);
        }
        finally
        {
            _exporting = false;
        }
    }

    private Task OnTmSourceLanguageInputChanged(string? value)
    {
        _tmSourceLanguageInput = value ?? string.Empty;
        _tmLanguageError = null;
        return Task.CompletedTask;
    }

    private Task OnTmTargetLanguageInputChanged(string? value)
    {
        _tmTargetLanguageInput = value ?? string.Empty;
        _tmLanguageError = null;
        return Task.CompletedTask;
    }

    /// <summary>语言对按回车提交（与失焦同一动作，TM 约定 §9.1 第 1/2 步）。</summary>
    private Task OnTmLanguageKeyDownAsync(KeyboardEventArgs args)
    {
        if (args.Key is "Enter" or "NumpadEnter")
        {
            return CommitLanguagesAsync();
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// 语言对提交（失焦/回车）：规范化后做行内校验——源/目标不得相同（交互规范 §3 表单校验），
    /// 通过后持久化并让各 TM 面板按新语言对重新请求（TM 约定 §9.1 第 1/2 步）。
    /// </summary>
    private Task CommitLanguagesAsync()
    {
        var normalized = LanguagePair.Normalize(_tmSourceLanguageInput, _tmTargetLanguageInput);
        if (normalized.HasSameLanguages)
        {
            _tmLanguageError = Localizer["TmLanguagesEqualError"].Value;
            return Task.CompletedTask;
        }

        _tmLanguageError = null;
        _tmLanguage = normalized;
        return TaskLanguagePairStore.SaveAsync(Js, TaskId, normalized);
    }

    private string GetSourceDisplay()
    {
        var source = _summary?.Source;
        if (source?.FileName is not null)
        {
            return source.FileName;
        }

        if (source?.RequestedUrl is not null)
        {
            return source.RequestedUrl;
        }

        return Localizer["SourceUnknown"];
    }

    private string GetSegmentationDisplay(TaskSegmentation segmentation)
    {
        var recommended = FormatSegmentationMode(segmentation.Recommended);
        var effective = FormatSegmentationMode(segmentation.Effective);
        var reason = segmentation.Reason switch
        {
            "blank_line_blocks_present" => Localizer["SegmentationReasonBlankLineBlocks"],
            "few_or_no_blank_lines" => Localizer["SegmentationReasonFewBlankLines"],
            _ => null,
        };

        var text = $"{Localizer["SegmentationRecommended", recommended]} → {Localizer["SegmentationEffective", effective]}";
        if (segmentation.Requested is not null)
        {
            text = $"{Localizer["SegmentationRequested", FormatSegmentationMode(segmentation.Requested)]}，{text}";
        }

        return reason is null ? text : $"{text}（{reason}）";
    }

    private string FormatSegmentationMode(string? mode)
    {
        return mode switch
        {
            "paragraph" => Localizer["SegmentationModeParagraph"],
            "line" => Localizer["SegmentationModeLine"],
            _ => mode ?? "-",
        };
    }

    private static string FormatBytes(long? byteLength)
    {
        if (byteLength is null)
        {
            return "-";
        }

        return byteLength.Value >= 1024
            ? $"{byteLength.Value / 1024.0:0.#} KB"
            : $"{byteLength.Value} B";
    }

}
