@namespace MyTranslator.Shared.Components
@inject IStringLocalizer<TermHint> L

@* 术语对齐提示：info 语义（图标+文字），只呈现后端结果，不自行推断对齐 *@
<section aria-label="@L["Title"]" class="mt-term-hint">
    <MudText Typo="Typo.h2" Class="mt-term-hint-title">@L["Title"]</MudText>
    @if (!LanguageReady)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["LanguageRequired"]</MudText>
    }
    else if (Items.Count == 0)
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary">@L["Empty"]</MudText>
    }
    else
    {
        <ul class="mt-term-hint-list">
            @foreach (var item in Items)
            {
                <li class="mt-term-hint-item">
                    <MudIcon Icon="@Icons.Material.Filled.MenuBook" Size="Size.Small" Color="Color.Info"
                             Class="mt-term-hint-icon" aria-hidden="true" />
                    <div class="mt-term-hint-body">
                        <MudText Typo="Typo.body2">@L["Expected", item.SourceTerm, item.ExpectedTargetTerm]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@L["Actual", item.TargetOccurrences]</MudText>
                    </div>
                </li>
            }
        </ul>
    }
</section>
@code {
    /// <summary>当前版本和语言对的后端未对齐项。</summary>
    [Parameter] public IReadOnlyList<TermMisalignment> Items { get; set; } = [];
    /// <summary>语言对已完整提供。</summary>
    [Parameter] public bool LanguageReady { get; set; }
}
