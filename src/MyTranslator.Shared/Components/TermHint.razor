@namespace MyTranslator.Shared.Components
@inject IStringLocalizer<TermHint> L

@* TODO(frontend-formal): 以正式术语侧栏替换此功能列表，不能自行推断对齐结果。 *@
<section aria-label="@L["Title"]" class="mt-3">
    <MudText Typo="Typo.h2">@L["Title"]</MudText>
    @if (!LanguageReady) { <MudText>@L["LanguageRequired"]</MudText> }
    else if (Items.Count == 0) { <MudText Typo="Typo.body2">@L["Empty"]</MudText> }
    else
    {
        @foreach (var item in Items)
        {
            <MudAlert Severity="Severity.Info" Class="my-2">
                <MudText>@L["Expected", item.SourceTerm, item.ExpectedTargetTerm]</MudText>
                <MudText Typo="Typo.caption">@L["Actual", item.TargetOccurrences]</MudText>
            </MudAlert>
        }
    }
</section>
@code {
    /// <summary>当前版本和语言对的后端未对齐项。</summary>
    [Parameter] public IReadOnlyList<TermMisalignment> Items { get; set; } = [];
    /// <summary>语言对已完整提供。</summary>
    [Parameter] public bool LanguageReady { get; set; }
}
