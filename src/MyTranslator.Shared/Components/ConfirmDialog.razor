@namespace MyTranslator.Shared.Components
@inject IStringLocalizer<SharedStrings> Localizer

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.h6">@Title</MudText>
        <MudText Typo="Typo.body2" Class="mt-2">@Message</MudText>
        @if (!string.IsNullOrEmpty(Detail))
        {
            <MudText Typo="Typo.body2" Color="Color.Error" Class="mt-2">@Detail</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Text" Color="Color.Default" OnClick="Cancel">@CancelText</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.WarningAmber"
                   OnClick="Confirm">
            @ConfirmText
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    /// <summary>弹窗标题。</summary>
    [Parameter]
    public string? Title { get; set; }

    /// <summary>后果说明正文。</summary>
    [Parameter, EditorRequired]
    public required string Message { get; set; }

    /// <summary>附加的强调信息（如将丢失的数量统计），以错误色展示。</summary>
    [Parameter]
    public string? Detail { get; set; }

    /// <summary>确认按钮文案；未传时使用资源默认值。</summary>
    [Parameter]
    public string? ConfirmText { get; set; }

    /// <summary>取消按钮文案；未传时使用资源默认值。</summary>
    [Parameter]
    public string? CancelText { get; set; }

    protected override void OnInitialized()
    {
        Title ??= Localizer["ConfirmDialog.Title"];
        ConfirmText ??= Localizer["ConfirmDialog.Confirm"];
        CancelText ??= Localizer["ConfirmDialog.Cancel"];
    }

    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));

    private void Cancel() => MudDialog.Close(DialogResult.Ok(false));
}
