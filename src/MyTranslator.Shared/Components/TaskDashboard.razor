@namespace MyTranslator.Shared.Components
@implements IAsyncDisposable
@using MyTranslator.Shared.Models
@using MyTranslator.Shared.Services
@inject ImportExportService Import
@inject ApiErrorMessageProvider ErrorProvider
@inject NavigationManager Nav
@inject IStringLocalizer<TaskDashboard> Localizer

<PageTitle>@Localizer["Title"]</PageTitle>

@* TODO(frontend-formal): 保留任务筛选、游标和轮询状态边界，正式前端再替换任务看板布局。 *@
@if (_refreshError is not null) { <ErrorBanner Message="@_refreshError" OnRetry="RefreshLoadedAsync" /> }

<div class="mt-tasklist-header">
    <div>
        <MudText Typo="Typo.h1">@Localizer["Title"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Localizer["Subtitle"]</MudText>
    </div>
    <div class="mt-tasklist-actions">
        <MudIconButton Icon="@Icons.Material.Filled.Refresh"
                       Color="Color.Default"
                       Disabled="_loading || _loadingMore || _refreshing"
                       OnClick="LoadFirstPageAsync"
                       aria-label="@Localizer["Refresh"]" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.Add"
                   OnClick="GoCreate">
            @Localizer["NewTask"]
        </MudButton>
    </div>
</div>

<div class="mt-tasklist-filter">
    <MudSelect T="string"
               Label="@Localizer["FilterLabel"]"
               Variant="Variant.Outlined"
               Dense="true"
               Value="@_status"
               ValueChanged="OnFilterChangedAsync"
               Disabled="_loading">
        <MudSelectItem Value="@string.Empty">@Localizer["FilterAll"]</MudSelectItem>
        <MudSelectItem Value="@("created")">@Localizer["FilterCreated"]</MudSelectItem>
        <MudSelectItem Value="@("processing")">@Localizer["FilterProcessing"]</MudSelectItem>
        <MudSelectItem Value="@("completed")">@Localizer["FilterCompleted"]</MudSelectItem>
        <MudSelectItem Value="@("failed")">@Localizer["FilterFailed"]</MudSelectItem>
    </MudSelect>
</div>

@if (_loadError is not null)
{
    <div class="mt-4">
        <ErrorBanner Message="@_loadError" OnRetry="LoadFirstPageAsync" />
    </div>
}
else if (_items is null)
{
    <div class="mt-4">
        @for (var i = 0; i < 5; i++)
        {
            <MudPaper Outlined="true" Elevation="0" Class="mt-tasklist-skeleton">
                <MudSkeleton Width="30%" Height="20px" />
                <MudSkeleton Width="60%" Height="14px" Class="mt-2" />
                <MudSkeleton Width="45%" Height="8px" Class="mt-3" />
            </MudPaper>
        }
    </div>
}
else if (_items.Count == 0)
{
    <MudPaper Outlined="true" Elevation="0" Class="pa-6 mt-4">
        <EmptyState Icon="@Icons.Material.Filled.Checklist"
                    Title="@Localizer["EmptyTitle"]"
                    Description="@(string.IsNullOrEmpty(_status) ? Localizer["EmptyDescription"] : Localizer["EmptyFilteredDescription"])"
                    ActionText="@Localizer["EmptyAction"]"
                    OnAction="GoCreate" />
    </MudPaper>
}
else
{
    <div class="mt-tasklist">
        @foreach (var item in _items)
        {
            <a class="mt-task-row" href="@($"/tasks/{item.TaskId}")">
                <div class="mt-task-row-main">
                    <div class="mt-task-row-head">
                        
                        <MudText Typo="Typo.body1" Class="mt-task-row-name">@GetSourceName(item)</MudText>
                    </div>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-task-row-meta">
                        @item.FileType · @Localizer["CreatedAt", FormatCreatedAt(item.CreatedAt)]
                    </MudText>
                    @if (item.Source?.Kind == "url" && item.Source.RequestedUrl is { Length: > 0 } requestedUrl)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-task-row-url">@requestedUrl</MudText>
                    }
                    @if (item.Progress is { } progress)
                    {
                        <ProgressBoard Status="@item.Status" Progress="progress" />
                    }
                    @if (item.LatestTranslationRun is { } run)
                    {
                        <MudText Typo="Typo.caption" Color="@RunColor(run)" Class="mt-task-row-run">
                            @FormatRunSummary(run)
                        </MudText>
                    }
                    @if (item.Status == "failed")
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-task-row-run">
                            @Localizer["FailedTaskHint"]
                        </MudText>
                    }
                </div>
                <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Medium" Color="Color.Default" Class="mt-task-row-chevron" />
            </a>
        }
        @if (_moreError is not null)
        {
            <div class="mt-tasklist-more-error">
                <ErrorBanner Message="@_moreError" RetryText="@Localizer["Retry"]" OnRetry="LoadMoreAsync" />
            </div>
        }
        else if (_loadingMore)
        {
            @for (var i = 0; i < 2; i++)
            {
                <MudPaper Outlined="true" Elevation="0" Class="mt-tasklist-skeleton">
                    <MudSkeleton Width="30%" Height="20px" />
                    <MudSkeleton Width="60%" Height="14px" Class="mt-2" />
                </MudPaper>
            }
        }
    </div>

    @* 屏幕阅读器状态区：列表加载/追加结果经 aria-live 播报（审查标准 维度四） *@
    @if (_announceCount is { } announceCount)
    {
        <div class="mt-sr-only" aria-live="polite">@Localizer["LoadedAnnouncement", announceCount]</div>
    }

    @if (_cursor is not null)
    {
        <div class="mt-tasklist-more">
            <MudButton Variant="Variant.Text" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.MoreHoriz"
                       Disabled="_loadingMore || _refreshing"
                       OnClick="LoadMoreAsync">
                @Localizer["LoadMore"]
            </MudButton>
        </div>
    }
}

@code {
    private string _status = string.Empty;
    private IReadOnlyList<TaskListItem>? _items;
    private string? _cursor;
    private string? _loadError;
    private string? _moreError;
    private bool _loading;
    private bool _loadingMore;
    private bool _refreshing;
    private string? _refreshError;
    private readonly CancellationTokenSource _lifetime = new();
    private Task? _polling;

    /// <summary>最近一次成功加载后的列表总数，供 aria-live 状态区播报。</summary>
    private int? _announceCount;
    /// <summary>首页加载代次：筛选切换使旧代次分页响应过期，防止旧筛选数据混入新列表。</summary>
    private int _loadGeneration;

    protected override async Task OnInitializedAsync()
    {
        await LoadFirstPageAsync();
        _polling = PollAsync();
    }

    private void GoCreate()
    {
        Nav.NavigateTo("/tasks/import");
    }

    /// <summary>切换状态筛选：游标绑定创建它时的筛选（契约 §2.2），更换筛选后必须从第一页重新加载。</summary>
    private async Task OnFilterChangedAsync(string status)
    {
        if (status == _status)
        {
            return;
        }

        _status = status;
        await LoadFirstPageAsync();
    }

    private async Task LoadFirstPageAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        _loadingMore = false;
        _loadError = null;
        _refreshError = null;
        _moreError = null;
        _items = null;
        _cursor = null;
        var generation = ++_loadGeneration;
        try
        {
            var page = await Import.GetTasksAsync(CurrentStatus, null, _lifetime.Token);
            if (generation != _loadGeneration)
            {
                return; // 筛选已再次切换：丢弃过期首页响应
            }

            _items = page.Items;
            _cursor = page.NextCursor;
            _announceCount = _items.Count;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            if (generation == _loadGeneration) _loadError = ErrorProvider.ForException(ex);
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_loadingMore || _refreshing || _cursor is null || _items is null)
        {
            return;
        }

        _loadingMore = true;
        _moreError = null;
        var generation = _loadGeneration;
        try
        {
            var page = await Import.GetTasksAsync(CurrentStatus, _cursor, _lifetime.Token);
            if (generation != _loadGeneration)
            {
                return; // 筛选已在途切换：旧筛选分页结果作废，避免混入新筛选列表或续用旧游标（契约 §4.5 invalid_cursor）
            }

            _items = _items.Concat(page.Items).DistinctBy(item => item.TaskId).ToArray();
            _cursor = page.NextCursor;
            _announceCount = _items.Count;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            if (generation == _loadGeneration) _moreError = ErrorProvider.ForException(ex);
        }
        finally
        {
            if (generation == _loadGeneration) _loadingMore = false;
        }
    }

    /// <summary>当前筛选值；空串表示全部任务，不携带 status 查询参数。</summary>
    private string? CurrentStatus => string.IsNullOrEmpty(_status) ? null : _status;

    private async Task PollAsync()
    {
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(3));
        try
        {
            while (await timer.WaitForNextTickAsync(_lifetime.Token)) await InvokeAsync(RefreshLoadedAsync);
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
    }

    private async Task RefreshLoadedAsync()
    {
        if (_loading || _loadingMore || _refreshing || _items is null) return;
        _refreshing = true;
        var generation = _loadGeneration;
        var count = _items.Count;
        var status = CurrentStatus;
        try
        {
            var rows = new List<TaskListItem>();
            string? cursor = null;
            do
            {
                var page = await Import.GetTasksAsync(status, cursor, _lifetime.Token);
                rows.AddRange(page.Items);
                cursor = page.NextCursor;
            } while (cursor is not null && rows.Count < count);
            if (generation != _loadGeneration) return;
            _items = rows.DistinctBy(item => item.TaskId).ToArray();
            _cursor = cursor;
            _refreshError = null;
        }
        catch (OperationCanceledException) when (_lifetime.IsCancellationRequested) { }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        { if (generation == _loadGeneration) _refreshError = ErrorProvider.ForException(ex); }
        finally { _refreshing = false; }
        if (!_lifetime.IsCancellationRequested) StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        await _lifetime.CancelAsync();
        if (_polling is not null) await _polling;
        _lifetime.Dispose();
    }

    private string GetSourceName(TaskListItem item)
    {
        var source = item.Source;
        if (source?.FileName is { Length: > 0 } fileName)
        {
            return fileName;
        }

        if (source?.RequestedUrl is { Length: > 0 } requestedUrl)
        {
            return requestedUrl;
        }

        return Localizer["SourceUnknown"];
    }

    private static string FormatCreatedAt(DateTimeOffset createdAt)
    {
        return createdAt.ToLocalTime().ToString("yyyy-MM-dd HH:mm");
    }

    /// <summary>最新翻译运行摘要行的语义色（复用 AI 翻译运行状态语义）。</summary>
    private static Color RunColor(LatestTranslationRun run)
    {
        return run.Status switch
        {
            "failed" or "partial_failed" => Color.Error,
            "completed" => Color.Success,
            _ => Color.Default,
        };
    }

    private string FormatRunSummary(LatestTranslationRun run)
    {
        var text = run.Status switch
        {
            "queued" => Localizer["RunQueued"],
            "processing" => Localizer["RunProcessing"],
            "completed" => Localizer["RunCompleted"],
            "partial_failed" => Localizer["RunPartialFailed"],
            "failed" => Localizer["RunFailed"],
            _ => Localizer["RunUnknown"],
        };

        // 活动运行附带当前百分比；终态百分比已反映在分段进度中，不再重复
        return run.Status is "queued" or "processing" && run.Progress is { } progress
            ? $"{text} · {Localizer["Percent", progress.Percent.ToString("0.#")]}"
            : text;
    }
}
