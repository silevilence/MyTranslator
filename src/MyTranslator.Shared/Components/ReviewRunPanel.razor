@namespace MyTranslator.Shared.Components
@inherits RunLifecycleBase<ReviewRun>
@inject ReviewRunService Runs
@inject IStringLocalizer<ReviewRunPanel> Localizer

<section class="mt-review-run" aria-labelledby="mt-review-run-title">
    <MudText Typo="Typo.h2" id="mt-review-run-title">@Localizer["Title"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["Description"]</MudText>

    @if (PollError is not null)
    {
        <div class="mt-4">
            <ErrorBanner Message="@PollError" RetryText="@Localizer["Retry"]" OnRetry="RetryAsync" />
        </div>
    }

    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
        <div class="mt-run-form">
            <MudTextField T="string"
                          Label="@Localizer["TargetLanguageLabel"]"
                          HelperText="@Localizer["TargetLanguageHelper"]"
                          Variant="Variant.Outlined"
                          Class="mt-run-field"
                          @bind-Value="_targetLanguage"
                          Disabled="CreateDisabled"
                          Error="_targetError is not null"
                          ErrorText="_targetError" />
            <MudTextField T="string"
                          Label="@Localizer["SourceLanguageLabel"]"
                          HelperText="@Localizer["SourceLanguageHelper"]"
                          Variant="Variant.Outlined"
                          Class="mt-run-field"
                          @bind-Value="_sourceLanguage"
                          Disabled="CreateDisabled" />
            <ProviderModelPicker @ref="_picker"
                                 TaskId="TaskId"
                                 Disabled="CreateDisabled"
                                 OnStateChanged="OnPickerStateChanged" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.RateReview"
                       Class="mt-run-start"
                       Disabled="CreateDisabled || string.IsNullOrWhiteSpace(_targetLanguage)"
                       OnClick="CreateRunAsync">
                @CreateSpinner
                @Localizer["StartReview"]
            </MudButton>
        </div>
        @if (_createConfigError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3" role="alert">
                <div class="mt-run-config-notice">
                    <span>@_createConfigError</span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="/settings" Class="mt-run-config-link">
                        @Localizer["GoSettings"]
                    </MudButton>
                </div>
            </MudAlert>
        }
        @if (ConfigNotice is { } notice)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3" role="status">
                <div class="mt-run-config-notice">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="mt-run-config-icon" />
                    <span>@notice</span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="/settings" Class="mt-run-config-link">
                        @Localizer["GoSettings"]
                    </MudButton>
                </div>
            </MudAlert>
        }
    </MudPaper>

    @if (Run is { } run)
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
            <div class="mt-run-header">
                @RunStatusBadge(run)
                @if (run.Selection is { } selection)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-2">
                        @Localizer["SelectionText", selection.SelectedSegments, selection.SkippedUntranslatedSegments]
                    </MudText>
                }
                @if (RunPairDisplay is { } pair)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-2">
                        @Localizer["RunSelection", pair.Provider, pair.Model]
                    </MudText>
                }
            </div>

            @if (run.Progress is { } progress)
            {
                <div class="mt-4" aria-live="polite">
                    <MudProgressLinear Value="@progress.Percent"
                                       Color="@StatusVisual(run).Color"
                                       Size="Size.Small"
                                       Rounded="true"
                                       Class="mt-run-progress" />
                    <div class="mt-run-progress-text">
                        <MudText Typo="Typo.body2">
                            @if (run.Selection is { } selection)
                            {
                                @Localizer["ProgressText",
                                    progress.ProcessedSegments,
                                    selection.SelectedSegments,
                                    progress.SucceededSegments,
                                    progress.FailedSegments]
                            }
                            else
                            {
                                @Localizer["ProgressTextNoTotal",
                                    progress.ProcessedSegments,
                                    progress.SucceededSegments,
                                    progress.FailedSegments]
                            }
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-run-percent">
                            @Localizer["Percent", progress.Percent.ToString("0.#")]
                        </MudText>
                    </div>
                </div>
            }

            @if (run.Status is "completed")
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" Class="mt-3" role="status">
                    @Localizer["CompletedNotice"]
                </MudAlert>
            }

            @if (run.Failure is { } failure)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                    <MudText Typo="Typo.body1">@ErrorProvider.ForFailureCode(failure.Code)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        @Localizer["FailureCount", failure.FailedSegments]
                    </MudText>
                    @if (failure.Retryable)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                            @Localizer["FailureRetryHint"]
                        </MudText>
                    }
                </MudAlert>

                @if (_failures.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-3 mb-1">@Localizer["FailureDetailsTitle"]</MudText>
                    <div class="mt-run-failures" role="list" aria-label="@Localizer["FailureDetailsTitle"]">
                        <Virtualize TItem="RunFailureItem" ItemsProvider="ProvideFailuresAsync" OverscanCount="6">
                            <ItemContent Context="item">
                                <div class="mt-run-failure-row" role="listitem">
                                    <code class="mt-mono mt-run-failure-order">@item.Order</code>
                                    <div class="mt-run-failure-info">
                                        <MudText Typo="Typo.body2">@ErrorProvider.ForFailureCode(item.Code)</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                            @Localizer["FailureAttempts", item.Attempts]
                                        </MudText>
                                    </div>
                                </div>
                            </ItemContent>
                            <EmptyContent>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">
                                    @Localizer["NoFailures"]
                                </MudText>
                            </EmptyContent>
                        </Virtualize>
                    </div>
                    @if (FailuresTruncated)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @Localizer["FailuresTruncated", MaxFailureItems]
                        </MudText>
                    }
                }

                <div class="mt-3">
                    @if (failure.Retryable)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="CreateDisabled"
                                   OnClick="CreateRunAsync">
                            @CreateSpinner
                            @Localizer["RetryReview"]
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["FailureNotRetryable"]</MudText>
                    }
                </div>
            }
        </MudPaper>
    }
</section>

@code {
    private const int FailurePageSize = 200;

    private string _targetLanguage = "zh-CN";
    private string _sourceLanguage = string.Empty;
    private string? _targetError;
    private bool _creating;
    private string? _createConfigError;
    private ProviderModelPicker? _picker;
    private IReadOnlyList<RunFailureItem> _failures = [];

    /// <summary>本轮成功提交意见的分段数增加：调用方重新读取分段，使逐批意见出现（§12.1 第 4 步）。</summary>
    [Parameter]
    public EventCallback OnCommentsCommitted { get; set; }

    /// <summary>运行进入终态或创建被互斥/配置类错误阻断：调用方刷新分段展示本轮意见（§12.1 第 5 步）。</summary>
    [Parameter]
    public EventCallback OnRunStateChanged { get; set; }

    /// <summary>审核按钮禁用条件：创建中、本地活动运行或他方活动互斥操作。</summary>
    private bool CreateDisabled => _creating || HasActiveRun || ExternalBusy;

    /// <summary>按钮提交中 spinner（§3 反馈分级：提交期间按钮 loading）。</summary>
    private RenderFragment CreateSpinner => __builder =>
    {
        if (_creating)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
        }
    };

    protected override async Task OnInitializedAsync()
    {
        // 提供商配置加载由 ProviderModelPicker 自行完成（共享任务级选择状态）
        try
        {
            var page = await Runs.ListRunsAsync(TaskId, 1, null);
            await RestoreLatestRunAsync(page.Items.FirstOrDefault());
        }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            PollError = ErrorProvider.ForException(ex);
            StateHasChanged();
        }
    }

    /// <summary>运行失效错误码（§2.4 重新提取级联删除旧运行）。</summary>
    protected override string RunNotFoundCode => "review_run_not_found";

    protected override Task<(ReviewRun Run, int? RetryAfterSeconds)> GetRunAsync(Guid runId, CancellationToken cancellationToken)
    {
        return Runs.GetRunAsync(TaskId, runId, cancellationToken)
            .ContinueWith(t => ((ReviewRun, int?))(t.Result.Run, t.Result.RetryAfterSeconds), cancellationToken);
    }

    protected override async Task<(IReadOnlyList<RunFailureItem> Items, string? NextCursor)> GetFailuresAsync(Guid runId, int limit, string? cursor)
    {
        var page = await Runs.GetFailuresAsync(TaskId, runId, limit, cursor);
        var items = page.Items
            .Select(f => new RunFailureItem(f.SegmentOrder, f.Code, f.Attempts))
            .ToList();
        return (items, page.NextCursor);
    }

    protected override int? SucceededOf(ReviewRun run) => run.Progress?.SucceededSegments;

    protected override Task OnSucceededIncreasedAsync() => OnCommentsCommitted.InvokeAsync();

    protected override async Task OnTerminalAsync()
    {
        // 终态：刷新分段使本轮意见可见（§12.1 第 5 步）；任务公共状态不变，无需刷新摘要
        await OnCommentsCommitted.InvokeAsync();
        await OnRunStateChanged.InvokeAsync();
    }

    protected override Task OnStateChangedAsync() => OnRunStateChanged.InvokeAsync();

    protected override Task SetFailuresAsync(IReadOnlyList<RunFailureItem> items, bool notify)
    {
        _failures = items;
        if (notify)
        {
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    /// <summary>虚拟化失败明细的分片提供器（组件规范 §2 长列表必须虚拟化；数据已全量加载，切片零开销）。</summary>
    private ValueTask<ItemsProviderResult<RunFailureItem>> ProvideFailuresAsync(ItemsProviderRequest request)
    {
        var slice = _failures.Skip(request.StartIndex).Take(request.Count).ToArray();
        return ValueTask.FromResult(new ItemsProviderResult<RunFailureItem>(slice, _failures.Count));
    }

    protected override bool IsTerminal(ReviewRun run)
    {
        return run.FinishedAt is not null || run.Status is "completed" or "partial_failed" or "failed";
    }

    protected override bool IsFailureTerminal(ReviewRun run) => run.Status is "partial_failed" or "failed";


    protected override Guid RunIdOf(ReviewRun run) => run.RunId;

    protected override string? StatusOf(ReviewRun run) => run.Status;

    protected override bool FinishedOf(ReviewRun run) => run.FinishedAt is not null;

    protected override async Task OnRetryWithoutRunAsync()
    {
        var page = await Runs.ListRunsAsync(TaskId, 1, null);
        await RestoreLatestRunAsync(page.Items.FirstOrDefault());
    }

    private async Task RetryAsync() => await RetryPollAsync();

    private RenderFragment RunStatusBadge(ReviewRun run) => __builder =>
    {
        var (text, color, icon) = StatusVisual(run);
        <MudChip T="string" Size="Size.Small" Color="color" Variant="Variant.Outlined" Icon="icon">@text</MudChip>
    };

    /// <summary>选择器/配置状态变化：重算配置提示（含运行回显解析依赖的配置数据）。</summary>
    private Task OnPickerStateChanged()
    {
        StateHasChanged();
        return Task.CompletedTask;
    }

    /// <summary>
    /// 配置状态提示（§12.1 第 1 步：复用翻译操作的配置异常提示）：
    /// 未配置默认对/未配置任何提供商时提示将影响审核；加载失败时提示配置状态未知。null 表示无需提示。
    /// </summary>
    private string? ConfigNotice
    {
        get
        {
            if (_picker is null)
            {
                return null;
            }

            if (_picker.ConfigError is not null)
            {
                return Localizer["ConfigLoadFailed"].Value;
            }

            var providers = _picker.Providers;
            if (providers is null)
            {
                return null;
            }

            if (providers.Count == 0)
            {
                return Localizer["ConfigNoProviders"].Value;
            }

            return _picker.HasDefaultPair ? null : Localizer["ConfigNoDefaultPair"].Value;
        }
    }

    /// <summary>
    /// 运行回显的提供商/模型名称（§4：运行资源回显解析后的实际选择）；
    /// 配置未加载或条目已被删除时回退为短 ID。null 表示运行无回显。
    /// </summary>
    private (string Provider, string Model)? RunPairDisplay
    {
        get
        {
            if (Run is not { ProviderId: { } providerId, ModelId: { } modelId })
            {
                return null;
            }

            var provider = _picker?.ProviderById(providerId);
            var model = provider?.Models.FirstOrDefault(m => m.Id == modelId);
            return (
                provider?.Name ?? ShortId(providerId),
                model?.DisplayName ?? ShortId(modelId));
        }
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    private async Task CreateRunAsync()
    {
        if (CreateDisabled)
        {
            return;
        }

        var target = _targetLanguage.Trim();
        if (target.Length == 0)
        {
            _targetError = Localizer["TargetLanguageRequired"];
            return;
        }

        _targetError = null;
        _creating = true;
        PollError = null;
        _createConfigError = null;
        try
        {
            var poll = await Runs.CreateRunAsync(
                TaskId,
                ExtractionRevision,
                string.IsNullOrWhiteSpace(_sourceLanguage) ? null : _sourceLanguage.Trim(),
                target,
                _picker?.SelectedProviderId,
                _picker?.SelectedModelId);
            Snackbar.Add(Localizer["RunStarted"], Severity.Info);
            await OnCreateSucceededAsync(poll.Run, poll.RetryAfterSeconds);
        }
        catch (ApiErrorException ex)
        {
            await HandleCreateErrorAsync(ex);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(ErrorProvider.For(null), Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }

    /// <summary>
    /// 创建错误处理（§11.1）：审核与翻译的差异——任何配置失败均不改变任务公共状态（§2.2），
    /// 因此 llm_not_configured 分支无需触发任务刷新，只提示配置异常并给出设置入口。
    /// </summary>
    private async Task HandleCreateErrorAsync(ApiErrorException ex)
    {
        switch (ex.Code)
        {
            case "extraction_revision_changed":
                // 修订已变化：通知页面按新修订刷新（组件随之重建）
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Warning);
                await OnRunStateChanged.InvokeAsync();
                break;
            case "no_segments_to_review":
                // 当前修订没有任何非空白译文：不创建运行、不改任务状态（§4 创建边界）
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Info);
                break;
            case "llm_not_configured":
            case "provider_not_found":
            case "model_not_found":
            case "provider_disabled":
                // 配置不可用（503/404/422）：不创建运行、不改任务状态；提示配置状态并给出设置入口（§12.1 第 5 步）
                _createConfigError = ErrorProvider.ForError(ex);
                Snackbar.Add(_createConfigError, Severity.Error);
                if (_picker is not null)
                {
                    await _picker.ReloadAsync();
                }
                break;
            case "task_busy":
                // 他处存在活动互斥操作（如翻译运行）：恢复最新审核运行以展示其进度
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Warning);
                await OnRetryWithoutRunAsync();
                break;
            default:
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Error);
                break;
        }
    }

    /// <summary>调用方当前看到的提取修订；创建运行请求必须携带（§2.4）。</summary>
    [Parameter, EditorRequired]
    public required int ExtractionRevision { get; set; }
}
