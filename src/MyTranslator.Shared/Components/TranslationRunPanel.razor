@namespace MyTranslator.Shared.Components
@inject ProviderConfigService Config
@inject Microsoft.JSInterop.IJSRuntime Js
@implements IDisposable
@inject TranslationRunService Runs
@inject ApiErrorMessageProvider ErrorProvider
@inject ISnackbar Snackbar
@inject IStringLocalizer<TranslationRunPanel> Localizer

<section class="mt-translation-run" aria-labelledby="mt-translation-run-title">
    <MudText Typo="Typo.h2" id="mt-translation-run-title">@Localizer["Title"]</MudText>
    <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["Description"]</MudText>

    @if (_pollError is not null)
    {
        <div class="mt-4">
            <ErrorBanner Message="@_pollError" RetryText="@Localizer["Retry"]" OnRetry="RetryAsync" />
        </div>
    }

    <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
        <div class="mt-translation-run-form">
            <MudTextField T="string"
                          Label="@Localizer["TargetLanguageLabel"]"
                          HelperText="@Localizer["TargetLanguageHelper"]"
                          Variant="Variant.Outlined"
                          Class="mt-translation-run-field"
                          @bind-Value="_targetLanguage"
                          Disabled="_creating || HasActiveRun"
                          Error="_targetError is not null"
                          ErrorText="_targetError" />
            <MudTextField T="string"
                          Label="@Localizer["SourceLanguageLabel"]"
                          HelperText="@Localizer["SourceLanguageHelper"]"
                          Variant="Variant.Outlined"
                          Class="mt-translation-run-field"
                          @bind-Value="_sourceLanguage"
                          Disabled="_creating || HasActiveRun" />
            <MudSelect T="string"
                       Label="@Localizer["ProviderLabel"]"
                       HelperText="@Localizer["ProviderHelper"]"
                       Placeholder="@ProviderPlaceholder"
                       Variant="Variant.Outlined"
                       Value="@(_selectedProviderId?.ToString() ?? string.Empty)"
                       ValueChanged="OnProviderChangedAsync"
                       Disabled="_creating || HasActiveRun || _configDisabled"
                       Clearable="true">
                @if (_providers is not null)
                {
                    foreach (var provider in _providers)
                    {
                        <MudSelectItem Value="@provider.Id.ToString()">@ProviderOptionLabel(provider)</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudSelect T="string"
                       Label="@Localizer["ModelLabel"]"
                       HelperText="@Localizer["ModelHelper"]"
                       Placeholder="@ModelPlaceholder"
                       Variant="Variant.Outlined"
                       Value="@(_selectedModelId?.ToString() ?? string.Empty)"
                       ValueChanged="OnModelChangedAsync"
                       Disabled="_creating || HasActiveRun || _configDisabled || _selectedProviderId is null"
                       Clearable="true">
                @if (SelectedProvider is { } selected)
                {
                    foreach (var model in selected.Models)
                    {
                        <MudSelectItem Value="@model.Id.ToString()">@ModelOptionLabel(model)</MudSelectItem>
                    }
                }
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.AutoAwesome"
                       Class="mt-translation-run-start"
                       Disabled="_creating || HasActiveRun || string.IsNullOrWhiteSpace(_targetLanguage)"
                       OnClick="CreateRunAsync">
                @CreateSpinner
                @Localizer["StartTranslation"]
            </MudButton>
        </div>
        @if (_createConfigError is not null)
        {
            <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3" role="alert">
                <div class="mt-translation-run-config-notice">
                    <span>@_createConfigError</span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="/settings" Class="mt-translation-run-config-link">
                        @Localizer["GoSettings"]
                    </MudButton>
                </div>
            </MudAlert>
        }
        @if (ConfigNotice is { } notice)
        {
            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3" role="status">
                <div class="mt-translation-run-config-notice">
                    <MudIcon Icon="@Icons.Material.Filled.Settings" Size="Size.Small" Class="mt-translation-run-config-icon" />
                    <span>@notice</span>
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               Href="/settings" Class="mt-translation-run-config-link">
                        @Localizer["GoSettings"]
                    </MudButton>
                </div>
            </MudAlert>
        }
    </MudPaper>

    @if (_run is not null)
    {
        <MudPaper Outlined="true" Elevation="0" Class="pa-4 mt-4">
            <div class="mt-translation-run-header">
                @RunStatusBadge(_run)
                @if (_run.Selection is { } selection)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-2">
                        @Localizer["SelectionText", selection.SelectedSegments, selection.SkippedExistingSegments]
                    </MudText>
                }
                @if (RunPairDisplay is { } pair)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ms-2">
                        @Localizer["RunSelection", pair.Provider, pair.Model]
                    </MudText>
                }
            </div>

            @if (_run.Progress is { } progress)
            {
                <div class="mt-4" aria-live="polite">
                    <MudProgressLinear Value="@progress.Percent"
                                       Color="@ProgressColor(_run)"
                                       Size="Size.Small"
                                       Rounded="true"
                                       Class="mt-translation-run-progress" />
                    <div class="mt-translation-run-progress-text">
                        <MudText Typo="Typo.body2">
                            @if (_run.Selection is { } selection)
                            {
                                @Localizer["ProgressText",
                                    progress.ProcessedSegments,
                                    selection.SelectedSegments,
                                    progress.SucceededSegments,
                                    progress.FailedSegments]
                            }
                            else
                            {
                                @Localizer["ProgressTextNoTotal",
                                    progress.ProcessedSegments,
                                    progress.SucceededSegments,
                                    progress.FailedSegments]
                            }
                        </MudText>
                        <MudText Typo="Typo.body2" Class="mt-translation-run-percent">
                            @Localizer["Percent", progress.Percent.ToString("0.#")]
                        </MudText>
                    </div>
                </div>
            }

            @if (_run.Failure is { } failure)
            {
                <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Class="mt-3">
                    <MudText Typo="Typo.body1">@ErrorProvider.ForFailureCode(failure.Code)</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                        @Localizer["FailureCount", failure.FailedSegments]
                    </MudText>
                    @if (failure.Retryable)
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">
                            @Localizer["FailureRetryHint"]
                        </MudText>
                    }
                </MudAlert>

                @if (_failures.Count > 0)
                {
                    <MudText Typo="Typo.body2" Class="mt-3 mb-1">@Localizer["FailureDetailsTitle"]</MudText>
                    <div class="mt-translation-run-failures">
                        @foreach (var item in _failures)
                        {
                            <div class="mt-translation-run-failure-row">
                                <code class="mt-mono mt-translation-run-failure-order">@item.SegmentOrder</code>
                                <div class="mt-translation-run-failure-info">
                                    <MudText Typo="Typo.body2">@ErrorProvider.ForFailureCode(item.Code)</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                        @Localizer["FailureAttempts", item.Attempts]
                                    </MudText>
                                </div>
                            </div>
                        }
                    </div>
                    @if (_failuresTruncated)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                            @Localizer["FailuresTruncated", MaxFailureItems]
                        </MudText>
                    }
                }

                <div class="mt-3">
                    @if (failure.Retryable)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   Disabled="_creating"
                                   OnClick="CreateRunAsync">
                            @CreateSpinner
                            @Localizer["RetryTranslation"]
                        </MudButton>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Localizer["FailureNotRetryable"]</MudText>
                    }
                </div>
            }
        </MudPaper>
    }
</section>

@code {
    private const int FailurePageSize = 200;

    /// <summary>失败明细读取上限（§7 要求终态后读取完整列表；防御极端规模保护渲染）。</summary>
    private const int MaxFailureItems = 5000;

    /// <summary>轮询连续瞬态失败次数上限：达到后停止轮询并展示错误横幅。</summary>
    private const int MaxPollRetries = 5;

    /// <summary>轮询瞬态失败指数退避上限（毫秒）。</summary>
    private const int MaxPollBackoffMs = 30000;

    private string _targetLanguage = "zh-CN";
    private string _sourceLanguage = string.Empty;
    private string? _targetError;
    private bool _creating;
    private TranslationRun? _run;
    private IReadOnlyList<SegmentTranslationFailure> _failures = [];
    private bool _failuresTruncated;
    private string? _pollError;
    private int _lastSucceeded;
    private int _pollIntervalMs = 1000;
    private CancellationTokenSource? _pollCts;
    // —— 提供商/模型选择（§11.1 第 2 步：选择器缺省显示默认对，选择随创建请求携带）——
    private IReadOnlyList<AiProvider>? _providers;
    private string? _configError;
    private bool _configDisabled;
    private Guid? _selectedProviderId;
    private Guid? _selectedModelId;
    private string? _createConfigError;

    /// <summary>按钮提交中 spinner（§3 反馈分级：提交期间按钮 loading）。</summary>
    private RenderFragment CreateSpinner => __builder =>
    {
        if (_creating)
        {
            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="me-2" />
        }
    };

    /// <summary>任务 ID。</summary>
    [Parameter, EditorRequired]
    public required Guid TaskId { get; set; }

    /// <summary>调用方当前看到的提取修订；创建运行请求必须携带（§2.4）。</summary>
    [Parameter, EditorRequired]
    public required int ExtractionRevision { get; set; }

    /// <summary>本次运行成功分段数增加时触发；调用方重新读取分段以逐步展示新译文（§11.1 第 4 步）。</summary>
    [Parameter]
    public EventCallback OnTranslationsCommitted { get; set; }

    /// <summary>
    /// 运行进入终态、或创建请求被互斥/配置类错误阻断使任务状态可能变化时触发；
    /// 调用方刷新任务摘要与分段（§11.1 第 5 步）。
    /// </summary>
    [Parameter]
    public EventCallback OnTaskStateChanged { get; set; }

    /// <summary>存在未进入终态的运行；活动运行期间禁止再次创建（§2.4 互斥）。</summary>
    private bool HasActiveRun => _run is not null && !IsTerminal(_run);

    /// <summary>按 ID 从已加载配置解析提供商；未选择或未找到为 null。</summary>
    private AiProvider? ProviderById(Guid? id) =>
        id is null ? null : _providers?.FirstOrDefault(p => p.Id == id);

    /// <summary>当前选中的提供商（按 ID 从已加载配置解析）。</summary>
    private AiProvider? SelectedProvider => ProviderById(_selectedProviderId);

    /// <summary>
    /// 配置状态提示（§11.1 第 2 步）：未配置默认对/未配置任何提供商时提示将影响翻译；
    /// 加载失败时提示配置状态未知。null 表示无需提示。
    /// </summary>
    private string? ConfigNotice
    {
        get
        {
            if (_configError is not null)
            {
                return Localizer["ConfigLoadFailed"].Value;
            }

            if (_providers is null)
            {
                return null;
            }

            if (_providers.Count == 0)
            {
                return Localizer["ConfigNoProviders"].Value;
            }

            return HasDefaultPair ? null : Localizer["ConfigNoDefaultPair"].Value;
        }
    }


    /// <summary>
    /// 运行回显的提供商/模型名称（§4：运行资源回显解析后的实际选择）；
    /// 配置未加载或条目已被删除时回退为短 ID。null 表示运行无回显。
    /// </summary>
    private (string Provider, string Model)? RunPairDisplay
    {
        get
        {
            if (_run is not { ProviderId: { } providerId, ModelId: { } modelId })
            {
                return null;
            }

            var provider = ProviderById(providerId);
            var model = provider?.Models.FirstOrDefault(m => m.Id == modelId);
            return (
                provider?.Name ?? ShortId(providerId),
                model?.DisplayName ?? ShortId(modelId));
        }
    }

    private static string ShortId(Guid id) => id.ToString("N")[..8];

    /// <summary>默认提供商 + 其默认模型合成默认对（配置约定 §2.2）。</summary>
    private bool HasDefaultPair => _providers.HasDefaultPair();

    /// <summary>提供商选择器占位文案：缺省显示默认对（交互规范 §1 / §11.1 第 2 步）；未配置时提示缺失。</summary>
    private string ProviderPlaceholder
    {
        get
        {
            var provider = _providers.DefaultProvider();
            var model = provider.DefaultModel();
            return provider is null || model is null
                ? Localizer["PlaceholderNoDefaultPair"].Value
                : Localizer["PlaceholderDefaultPair", provider.Name, model.DisplayName].Value;
        }
    }

    /// <summary>
    /// 模型选择器占位文案：严格对应三档解析（§3.1）。
    /// 未选提供商（走默认对）→ 显示默认对的默认模型；
    /// 选中提供商（只传 providerId）→ 显示**该提供商**的默认模型，
    /// 无默认模型时如实提示（此时提交将 422 model_not_found），不回退其他提供商的模型名。
    /// </summary>
    private string ModelPlaceholder
    {
        get
        {
            var model = SelectedProvider is null
                ? _providers.DefaultProvider().DefaultModel()
                : SelectedProvider.DefaultModel();
            return model is null
                ? Localizer["PlaceholderNoDefaultModel"].Value
                : Localizer["PlaceholderDefaultModel", model.DisplayName].Value;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await Task.WhenAll(RestoreLatestRunAsync(), LoadProviderConfigAsync());
    }

    /// <summary>
    /// 加载两级配置并恢复上次选择（§11.1 第 2/6 步）：一次 GET 内嵌 models；
    /// 恢复的选择必须仍存在于当前配置，否则回退到缺省（默认对）。
    /// </summary>
    private async Task LoadProviderConfigAsync()
    {
        try
        {
            _providers = await Config.GetProvidersAsync();
            _configError = null;
            _configDisabled = false;
            await RestoreSelectionAsync();
        }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            // 配置加载失败不禁用语言表单，仅禁用选择器并提示
            _configError = ErrorProvider.ForException(ex);
            _configDisabled = true;
        }

        StateHasChanged();
    }

    /// <summary>从 localStorage 恢复持久化的选择；校验引用的提供商/模型仍存在。</summary>
    private async Task RestoreSelectionAsync()
    {
        var (providerId, modelId) = await ProviderSelectionStore.LoadAsync(Js, TaskId);
        if (_providers is null)
        {
            return;
        }

        var provider = ProviderById(providerId);
        if (provider is null)
        {
            return; // 提供商已删除或未选择：保持缺省（默认对）
        }

        _selectedProviderId = provider.Id;
        if (modelId is not null && provider.Models.Any(m => m.Id == modelId))
        {
            _selectedModelId = modelId;
        }
    }

    /// <summary>提供商选择变化：清空模型选择，持久化并按三档解析规则归一。</summary>
    private async Task OnProviderChangedAsync(string? value)
    {
        _selectedProviderId = Guid.TryParse(value, out var id) ? id : null;
        _selectedModelId = null;
        await PersistSelectionAsync();
        StateHasChanged();
    }

    /// <summary>模型选择变化：持久化；清除模型回到「该提供商默认模型」档。</summary>
    private async Task OnModelChangedAsync(string? value)
    {
        _selectedModelId = Guid.TryParse(value, out var id) ? id : null;
        await PersistSelectionAsync();
        StateHasChanged();
    }

    private async Task PersistSelectionAsync()
    {
        await ProviderSelectionStore.SaveAsync(Js, TaskId, _selectedProviderId, _selectedModelId);
    }

    /// <summary>选项文案：名称 + 默认/停用标记（不引入额外组件）。</summary>
    private string ProviderOptionLabel(AiProvider provider)
    {
        var suffix = provider.IsDefault
            ? Localizer["OptionDefaultSuffix"].Value
            : provider.Enabled ? string.Empty : Localizer["OptionDisabledSuffix"].Value;
        return $"{provider.Name}{suffix}";
    }

    private string ModelOptionLabel(AiModel model) => model.IsDefault
        ? $"{model.DisplayName}（{model.ModelId}）{Localizer["OptionDefaultSuffix"].Value}"
        : $"{model.DisplayName}（{model.ModelId}）";

    /// <summary>
    /// 页面刷新后恢复最新运行（§11.1 第 6 步）：读取运行列表第一项，活动运行恢复轮询。
    /// 重新提取后旧修订的运行已失效，列表为空即为干净初始态。
    /// </summary>
    private async Task RestoreLatestRunAsync()
    {
        try
        {
            var page = await Runs.ListRunsAsync(TaskId, 1, null);
            var run = page.Items.FirstOrDefault();
            if (run is null)
            {
                return;
            }

            _run = run;
            _lastSucceeded = run.Progress?.SucceededSegments ?? 0;
            if (IsTerminal(run))
            {
                if (run.Status is "partial_failed" or "failed")
                {
                    await LoadFailuresAsync();
                }
            }
            else
            {
                StartPolling(run);
            }
        }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            _pollError = ErrorProvider.ForException(ex);
        }

        StateHasChanged();
    }

    private async Task CreateRunAsync()
    {
        if (_creating || HasActiveRun)
        {
            return;
        }

        var target = _targetLanguage.Trim();
        if (target.Length == 0)
        {
            _targetError = Localizer["TargetLanguageRequired"];
            return;
        }

        _targetError = null;
        _creating = true;
        _pollError = null;
        _createConfigError = null;
        try
        {
            var poll = await Runs.CreateRunAsync(
                TaskId,
                ExtractionRevision,
                string.IsNullOrWhiteSpace(_sourceLanguage) ? null : _sourceLanguage.Trim(),
                target,
                _selectedProviderId,
                _selectedModelId);
            var run = poll.Run;
            _run = run;
            _failures = [];
            _failuresTruncated = false;
            _lastSucceeded = 0;
            _pollIntervalMs = Math.Max(poll.RetryAfterSeconds ?? 1, 1) * 1000;
            Snackbar.Add(Localizer["RunStarted"], Severity.Info);
            StartPolling(run);
        }
        catch (ApiErrorException ex)
        {
            await HandleCreateErrorAsync(ex);
        }
        catch (HttpRequestException)
        {
            Snackbar.Add(ErrorProvider.For(null), Severity.Error);
        }
        finally
        {
            _creating = false;
        }
    }

    private async Task HandleCreateErrorAsync(ApiErrorException ex)
    {
        switch (ex.Code)
        {
            case "extraction_revision_changed":
                // 修订已变化：通知页面按新修订刷新（组件随之重建）
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Warning);
                await OnTaskStateChanged.InvokeAsync();
                break;
            case "no_segments_to_translate":
                // 全部已有译文，任务可能已被服务端修正为 completed
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Info);
                await OnTaskStateChanged.InvokeAsync();
                break;
            case "llm_not_configured":
                // 未创建运行，任务被服务端标记为 failed；提示配置状态并给出设置入口（§11.1 第 5 步）
                _createConfigError = ErrorProvider.ForError(ex);
                Snackbar.Add(_createConfigError, Severity.Error);
                await OnTaskStateChanged.InvokeAsync();
                break;
            case "provider_not_found":
            case "model_not_found":
            case "provider_disabled":
                // 显式选择不可解析（404/422）：不创建运行、不改任务状态；提示配置状态并给出设置入口
                _createConfigError = ErrorProvider.ForError(ex);
                Snackbar.Add(_createConfigError, Severity.Error);
                await LoadProviderConfigAsync();
                break;
            case "task_busy":
                // 他处存在活动互斥操作（如另一运行）：恢复最新运行以展示其进度
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Warning);
                await RestoreLatestRunAsync();
                break;
            default:
                Snackbar.Add(ErrorProvider.ForError(ex), Severity.Error);
                break;
        }
    }

    private void StartPolling(TranslationRun run)
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
        _pollCts = new CancellationTokenSource();
        _ = PollLoopAsync(_pollCts.Token);
    }

    /// <summary>
    /// 按 Retry-After 轮询运行详情（§5）：间隔不得短于 1 秒；进度与阶段文案一律取服务端快照。
    /// 运行失效（404/409）立即停止并通知页面；瞬态错误（5xx/网络）指数退避续轮，
    /// 连续失败达到上限后停止并展示错误横幅，避免后端持续异常时空转请求；
    /// 其余契约错误（4xx）立即停止，不做退避重试。
    /// </summary>
    private async Task PollLoopAsync(CancellationToken cancellationToken)
    {
        var pollErrors = 0;
        try
        {
            while (!cancellationToken.IsCancellationRequested && _run is not null && !IsTerminal(_run))
            {
                await Task.Delay(_pollIntervalMs, cancellationToken);
                try
                {
                    var poll = await Runs.GetRunAsync(TaskId, _run.RunId, cancellationToken);
                    pollErrors = 0;
                    _pollIntervalMs = Math.Max(poll.RetryAfterSeconds ?? 1, 1) * 1000;
                    _pollError = null;
                    _run = poll.Run;

                    if (_run.Progress is { SucceededSegments: > 0 } progress && progress.SucceededSegments > _lastSucceeded)
                    {
                        _lastSucceeded = progress.SucceededSegments;
                        await OnTranslationsCommitted.InvokeAsync();
                    }

                    StateHasChanged();

                    if (IsTerminal(_run))
                    {
                        await OnRunTerminalAsync();
                        return;
                    }
                }
                catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
                {
                    return;
                }
                catch (ApiErrorException ex) when (IsRunInvalidated(ex.Code))
                {
                    // 运行随重新提取失效（§2.4）：本地状态重置，由页面按新修订重建
                    ResetRunState();
                    Snackbar.Add(ErrorProvider.ForError(ex), Severity.Warning);
                    await OnTaskStateChanged.InvokeAsync();
                    return;
                }
                catch (Exception ex) when (ex is HttpRequestException or ApiErrorException { StatusCode: >= 500 })
                {
                    // 瞬态错误（5xx/网络）：指数退避后重试
                    pollErrors++;
                    if (pollErrors >= MaxPollRetries)
                    {
                        _pollIntervalMs = 1000;
                        _pollError = ErrorProvider.ForException(ex);
                        StateHasChanged();
                        return;
                    }

                    _pollIntervalMs = Math.Min(_pollIntervalMs * 2, MaxPollBackoffMs);
                }
                catch (ApiErrorException ex)
                {
                    // 其余契约错误（4xx）：非瞬态，立即停止并展示错误横幅
                    _pollIntervalMs = 1000;
                    _pollError = ErrorProvider.ForError(ex);
                    StateHasChanged();
                    return;
                }
            }
        }
        catch (OperationCanceledException)
        {
            // 组件销毁或重启轮询：静默退出
        }
    }

    private async Task OnRunTerminalAsync()
    {
        if (_run is not { } run)
        {
            return;
        }

        if (run.Status is "partial_failed" or "failed")
        {
            await LoadFailuresAsync();
        }

        // 终态：刷新任务与分段（§11.1 第 5 步）
        await OnTaskStateChanged.InvokeAsync();
    }

    /// <summary>
    /// 读取已确定的分段级失败（§7）：终态后沿游标读取完整列表；
    /// 超过 <see cref="MaxFailureItems"/> 时截断并提示（极端规模防御）。
    /// </summary>
    private async Task LoadFailuresAsync()
    {
        if (_run is not { } run)
        {
            return;
        }

        try
        {
            var items = new List<SegmentTranslationFailure>();
            string? cursor = null;
            do
            {
                var page = await Runs.GetFailuresAsync(TaskId, run.RunId, FailurePageSize, cursor);
                items.AddRange(page.Items);
                cursor = page.NextCursor;
            }
            while (cursor is not null && items.Count < MaxFailureItems);

            _failures = items;
            _failuresTruncated = cursor is not null;
        }
        catch (ApiErrorException ex) when (IsRunInvalidated(ex.Code))
        {
            ResetRunState();
            Snackbar.Add(ErrorProvider.ForError(ex), Severity.Warning);
            await OnTaskStateChanged.InvokeAsync();
        }
        catch (Exception ex) when (ex is ApiErrorException or HttpRequestException)
        {
            _pollError = ErrorProvider.ForException(ex);
        }

        StateHasChanged();
    }

    private async Task RetryAsync()
    {
        _pollError = null;
        if (_run is null)
        {
            await RestoreLatestRunAsync();
        }
        else if (IsTerminal(_run))
        {
            await LoadFailuresAsync();
        }
        else
        {
            StartPolling(_run);
        }
    }

    /// <summary>
    /// 运行是否进入终态：以服务端 <c>finishedAt</c> 为准（§9 终态时 finishedAt 非空）。
    /// 未知枚举值若已带 finishedAt 视为终态，避免对新增终态永久轮询（§2.1 容忍未知值）。
    /// </summary>
    private static bool IsTerminal(TranslationRun run)
    {
        return run.FinishedAt is not null || run.Status is "completed" or "partial_failed" or "failed";
    }

    /// <summary>运行是否已因重新提取失效（§2.4）：本地状态需重置并由页面按新修订重建。</summary>
    private static bool IsRunInvalidated(string? code)
    {
        return code is "translation_run_not_found" or "extraction_revision_changed";
    }

    /// <summary>重置当前运行及其派生状态（运行失效时使用）。</summary>
    private void ResetRunState()
    {
        _run = null;
        _failures = [];
        _failuresTruncated = false;
    }

    /// <summary>
    /// 运行状态的唯一视觉映射（文字 + 语义色 + 图标，三通道一致）：
    /// 进度条颜色与状态徽标共用本映射，避免两处 switch 漂移。
    /// 未知状态但已终态（finishedAt 非空）按中性处理；未知活动状态按进行中（Info）处理。
    /// </summary>
    private (string Text, Color Color, string Icon) RunStatusVisual(TranslationRun run) => run.Status switch
    {
        "queued" => (Localizer["RunQueued"], Color.Default, Icons.Material.Filled.Schedule),
        "processing" => (Localizer["RunProcessing"], Color.Info, Icons.Material.Filled.Sync),
        "completed" => (Localizer["RunCompleted"], Color.Success, Icons.Material.Filled.CheckCircle),
        "partial_failed" => (Localizer["RunPartialFailed"], Color.Error, Icons.Material.Filled.WarningAmber),
        "failed" => (Localizer["RunFailed"], Color.Error, Icons.Material.Filled.ErrorOutline),
        _ when run.FinishedAt is not null => (Localizer["RunUnknown"], Color.Default, Icons.Material.Filled.HelpOutline),
        _ => (Localizer["RunUnknown"], Color.Info, Icons.Material.Filled.HelpOutline),
    };

    private Color ProgressColor(TranslationRun run) => RunStatusVisual(run).Color;

    private RenderFragment RunStatusBadge(TranslationRun run) => __builder =>
    {
        var (text, color, icon) = RunStatusVisual(run);
        <MudChip T="string" Size="Size.Small" Color="color" Variant="Variant.Outlined" Icon="icon">@text</MudChip>
    };

    public void Dispose()
    {
        _pollCts?.Cancel();
        _pollCts?.Dispose();
    }
}
