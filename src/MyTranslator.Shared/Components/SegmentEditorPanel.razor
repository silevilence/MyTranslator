@namespace MyTranslator.Shared.Components
@inject IStringLocalizer<SegmentEditorPanel> L

<div @ref="_panel" tabindex="-1" @onkeydown="OnKeyDown" @onkeydown:stopPropagation="true" class="mt-seg-panel">
    @if (Draft is null)
    {
        <EmptyState Icon="@Icons.Material.Filled.Translate" Title="@L["SelectFirst"]" />
    }
    else
    {
        <div class="mt-seg-head">
            <MudText Typo="Typo.h2" Class="mt-seg-head-title">
                @L["Segment", Draft.Original.Order] @if (Draft.IsDirty) { <span class="mt-seg-dirty" aria-label="@L["Dirty"]">●</span> }
            </MudText>
            <MudChip T="string" Size="Size.Small"
                     Color="@(Draft.Original.ConfirmationStatus == "confirmed" ? Color.Success : Color.Default)"
                     Icon="@(Draft.Original.ConfirmationStatus == "confirmed" ? Icons.Material.Filled.CheckCircle : Icons.Material.Filled.Pending)">
                @L[Draft.Original.ConfirmationStatus ?? "pending"]
            </MudChip>
        </div>
        <section class="mt-seg-source" aria-label="@L["SourceLabel"]">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-seg-area-label">@L["SourceLabel"]</MudText>
            <div class="mt-seg-source-text">
                <SegmentMarkupViewer Text="@(Draft.Original.SourceText ?? string.Empty)" MarkupTable="Draft.Original.MarkupTable" />
            </div>
        </section>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-seg-hint">@L["ProtectedHint"]</MudText>
        <div class="mt-seg-surface" role="group" aria-label="@L["TargetLabel"]">
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-seg-area-label">@L["TargetLabel"]</MudText>
            <div class="mt-seg-surface-flow">
                @for (var index = 0; index < Draft.Parts.Count; index++)
                {
                    var partIndex = index;
                    var part = Draft.Parts[index];
                    if (part.Markup is not null)
                    {
                        <span class="mt-seg-chip" aria-hidden="true">
                            <SegmentMarkupViewer Text="@part.Text" MarkupTable="Draft.Original.MarkupTable" />
                        </span>
                    }
                    else
                    {
                        <MudTextField T="string" Value="@part.Text" ValueChanged="value => ChangeAsync(partIndex, value)" Immediate="true"
                                      Lines="1" MaxLines="14" Sizing="InputSizing.Auto" Variant="Variant.Text" Disabled="Disabled"
                                      Class="mt-seg-input" aria-label="@L["TextPart", EditableOrdinal(index)]" />
                    }
                }
            </div>
        </div>
        <MudStack Row="true" Spacing="2" Class="mt-seg-actions">
            <MudButton OnClick="OnSave" Disabled="Disabled" Variant="Variant.Filled" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Save">@L["Save"]</MudButton>
            <MudButton OnClick="OnConfirm" Disabled="Disabled || Draft.TargetText is null" Variant="Variant.Filled" Color="Color.Success"
                       StartIcon="@Icons.Material.Filled.Check">@L["Confirm"]</MudButton>
            <MudButton OnClick="OnUnconfirm" Disabled="@(Disabled || Draft.Original.ConfirmationStatus != "confirmed")"
                       Variant="Variant.Outlined">@L["Unconfirm"]</MudButton>
            <MudButton OnClick="OnClear" Disabled="Disabled || Draft.TargetText is null" Variant="Variant.Text" Color="Color.Error"
                       StartIcon="@Icons.Material.Filled.DeleteOutline">@L["Clear"]</MudButton>
        </MudStack>
        <ReviewPanel Comments="Draft.Original.ReviewComments" />
        @if (References is not null) { @References(Draft.Original) }
    }
</div>

@code {
    private ElementReference _panel;
    /// <summary>当前不可变分段快照与可编辑草稿。</summary>
    [Parameter] public SegmentDraft? Draft { get; set; }
    /// <summary>提交/运行期间禁用编辑。</summary>
    [Parameter] public bool Disabled { get; set; }
    /// <summary>草稿内容变化通知。</summary>
    [Parameter] public EventCallback OnChange { get; set; }
    /// <summary>保存草稿。</summary>
    [Parameter] public EventCallback OnSave { get; set; }
    /// <summary>保存并确认。</summary>
    [Parameter] public EventCallback OnConfirm { get; set; }
    /// <summary>取消确认。</summary>
    [Parameter] public EventCallback OnUnconfirm { get; set; }
    /// <summary>清空译文，父组件负责危险操作确认。</summary>
    [Parameter] public EventCallback OnClear { get; set; }
    /// <summary>编辑区快捷键，不处理普通方向键和问号输入。</summary>
    [Parameter] public EventCallback<KeyboardEventArgs> OnKeyDown { get; set; }
    /// <summary>详情参考区扩展。</summary>
    [Parameter] public RenderFragment<Segment>? References { get; set; }
    public Task FocusAsync() => _panel.FocusAsync().AsTask();

    /// <summary>编辑面文本框的序号：按可编辑间隙顺序编号，占位符不占号，读屏标签连续。</summary>
    private int EditableOrdinal(int index)
    {
        var ordinal = 0;
        for (var i = 0; i <= index; i++)
        {
            if (Draft!.Parts[i].Markup is null) ordinal++;
        }
        return ordinal;
    }

    private async Task ChangeAsync(int index, string? text)
    {
        Draft!.SetText(index, text);
        await OnChange.InvokeAsync();
    }
}
