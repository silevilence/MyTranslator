@namespace MyTranslator.Shared.Components
@inject IStringLocalizer<ProgressBoard> L

@* 完成度与确认度分离呈现（CONTEXT.md：确认≠完成）；行内标签即语义说明，非纯颜色传达 *@
<div aria-live="polite" class="mt-progress">
    <div class="mt-progress-status"><TaskStatusBadge Status="@Status" /></div>
    <div class="mt-progress-row">
        <MudText Typo="Typo.caption" Class="mt-progress-label">@L["Completed", Progress.CompletedSegments, Progress.TotalSegments, Progress.Percent.ToString("0.#")]</MudText>
        <MudProgressLinear Value="Progress.Percent" Color="Color.Info" Class="mt-progress-bar" aria-label="@L["CompletionLabel"]" />
    </div>
    <div class="mt-progress-row">
        <MudText Typo="Typo.caption" Class="mt-progress-label">@L["Confirmed", Progress.ConfirmedSegments, Progress.TotalSegments, Progress.ConfirmedPercent.ToString("0.#")]</MudText>
        <MudProgressLinear Value="Progress.ConfirmedPercent" Color="Color.Success" Class="mt-progress-bar" aria-label="@L["ConfirmationLabel"]" />
    </div>
</div>
@code {
    /// <summary>服务端任务状态。</summary>
    [Parameter] public string? Status { get; set; }
    /// <summary>服务端分段计数；受保护块不计入。</summary>
    [Parameter] public TaskProgress Progress { get; set; } = new();
}
