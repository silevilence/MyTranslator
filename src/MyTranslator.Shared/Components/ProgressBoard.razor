@namespace MyTranslator.Shared.Components
@inject IStringLocalizer<ProgressBoard> L

@* TODO(frontend-formal): 此看板仅验证服务端状态、完成与确认进度，正式前端再细化布局和视觉。 *@
<div aria-live="polite" class="my-2">
    <TaskStatusBadge Status="@Status" />
    <MudText Typo="Typo.body2">@L["Completed", Progress.CompletedSegments, Progress.TotalSegments, Progress.Percent.ToString("0.#")]</MudText>
    <MudProgressLinear Value="Progress.Percent" Color="Color.Info" aria-label="@L["CompletionLabel"]" />
    <MudText Typo="Typo.body2" Class="mt-2">@L["Confirmed", Progress.ConfirmedSegments, Progress.TotalSegments, Progress.ConfirmedPercent.ToString("0.#")]</MudText>
    <MudProgressLinear Value="Progress.ConfirmedPercent" Color="Color.Success" aria-label="@L["ConfirmationLabel"]" />
</div>
@code {
    /// <summary>服务端任务状态。</summary>
    [Parameter] public string? Status { get; set; }
    /// <summary>服务端分段计数；受保护块不计入。</summary>
    [Parameter] public TaskProgress Progress { get; set; } = new();
}
