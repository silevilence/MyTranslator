@namespace MyTranslator.Shared.Components
@inject IStringLocalizer<TaskStatusBadge> Localizer

@* 任务公共状态徽标：颜色 + 图标 + 文字三通道（交互规范 §4） *@
<MudChip T="string" Size="Size.Small" Color="@StatusColor" Variant="Variant.Outlined" Icon="@Icon">@Text</MudChip>

@code {
    /// <summary>任务公共状态：`created` / `processing` / `completed` / `failed`。</summary>
    [Parameter, EditorRequired]
    public required string? Status { get; set; }

    private string Text => Status switch
    {
        "created" => Localizer["StatusCreated"],
        "processing" => Localizer["StatusProcessing"],
        "completed" => Localizer["StatusCompleted"],
        "failed" => Localizer["StatusFailed"],
        _ => Localizer["StatusUnknown"],
    };

    /// <summary>语义色取共享映射（<see cref="SemanticColor"/>），避免页面内映射重复。</summary>
    private Color StatusColor => SemanticColor(Status);

    private string? Icon => Status switch
    {
        "created" => Icons.Material.Filled.Schedule,
        "processing" => Icons.Material.Filled.Sync,
        "completed" => Icons.Material.Filled.CheckCircle,
        "failed" => Icons.Material.Filled.ErrorOutline,
        _ => Icons.Material.Filled.HelpOutline,
    };
}
