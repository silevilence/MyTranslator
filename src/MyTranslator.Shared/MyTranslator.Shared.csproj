<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyTranslator.Shared</RootNamespace>
    <!-- 关闭本库静态资产指纹化：RCL 隔离样式 bundle（*.bundle.scp.css）带指纹名时，
         消费端 index.html 的固定名引用在发布态会 404（.NET 10 对库生成 bundle 的 HTML 指纹改写不生效）。
         本库资产均以固定名引用（mt.css / js / bundle），关闭指纹化保持两条托管流程一致。 -->
    <StaticWebAssetFingerprintingEnabled>false</StaticWebAssetFingerprintingEnabled>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyTranslator.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <!-- 组件 resx：LogicalName 与组件类型全名一致（组件规范 §5） -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\TaskDashboard.resx"><LogicalName>MyTranslator.Shared.Components.TaskDashboard.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\ProgressBoard.resx"><LogicalName>MyTranslator.Shared.Components.ProgressBoard.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\TokenManagementPanel.resx"><LogicalName>MyTranslator.Shared.Components.TokenManagementPanel.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\TermHint.resx"><LogicalName>MyTranslator.Shared.Components.TermHint.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\SegmentList.resx"><LogicalName>MyTranslator.Shared.Components.SegmentList.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\SegmentEditorPanel.resx"><LogicalName>MyTranslator.Shared.Components.SegmentEditorPanel.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\TranslationEditor.resx"><LogicalName>MyTranslator.Shared.Components.TranslationEditor.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\KeyboardHelp.resx"><LogicalName>MyTranslator.Shared.Components.KeyboardHelp.resources</LogicalName></EmbeddedResource>
    <EmbeddedResource Update="Resources\ReextractionPanel.resx">
      <LogicalName>MyTranslator.Shared.Components.ReextractionPanel.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ProviderModelPicker.resx">
