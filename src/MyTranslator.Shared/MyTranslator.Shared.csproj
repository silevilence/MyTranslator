<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MyTranslator.Shared</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="MyTranslator.Shared.Tests" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.11" />
    <PackageReference Include="MudBlazor" Version="9.8.0" />
  </ItemGroup>

  <!-- 组件 resx：LogicalName 与组件类型全名一致（组件规范 §5） -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\ReextractionPanel.resx">
      <LogicalName>MyTranslator.Shared.Components.ReextractionPanel.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ProviderModelPicker.resx">
      <LogicalName>MyTranslator.Shared.Components.ProviderModelPicker.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ReviewPanel.resx">
      <LogicalName>MyTranslator.Shared.Components.ReviewPanel.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ReviewRunPanel.resx">
      <LogicalName>MyTranslator.Shared.Components.ReviewRunPanel.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TranslationRunPanel.resx">
      <LogicalName>MyTranslator.Shared.Components.TranslationRunPanel.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\ProviderConfigPanel.resx">
      <LogicalName>MyTranslator.Shared.Components.ProviderConfigPanel.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TaskStatusBadge.resx">
      <LogicalName>MyTranslator.Shared.Components.TaskStatusBadge.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TermsPanel.resx">
      <LogicalName>MyTranslator.Shared.Components.TermsPanel.resources</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Update="Resources\TermEditDialog.resx">
      <LogicalName>MyTranslator.Shared.Components.TermEditDialog.resources</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
