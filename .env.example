# Copy to .env. Generate your own token: sk- followed by 32 hexadecimal characters.
# PowerShell: 'sk-' + [guid]::NewGuid().ToString('N')
# Leave no spaces around '='. Empty INITIAL_TOKEN intentionally prevents startup.
INITIAL_TOKEN=

WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# AI provider credentials and models are configured through /api/providers
# after startup and stored in SQLite. Do not add LLM keys to this file.
